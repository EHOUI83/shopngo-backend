# Copie ce fichier en ".env" et remplis tes vraies clés (jamais dans le code, jamais partagées publiquement)

# Clé secrète Stripe (Développeurs > Clés API). Commence par sk_test_ en mode test, sk_live_ en réel.
STRIPE_SECRET_KEY=sk_test_...

# Clé de signature du webhook (Développeurs > Webhooks > ton endpoint > "Signing secret")
STRIPE_WEBHOOK_SECRET=whsec_...

# URL de ton site (celle où est publiée la page Shop'N'Go), utilisée pour rediriger le client après paiement
SITE_URL=https://ton-site.exemple.com

# Port local (optionnel, 4242 par défaut)
PORT=4242
